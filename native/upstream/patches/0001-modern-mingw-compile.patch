 #include <sys/stat.h>
 #endif /* HPE_mingw_BUILD */
 #include <unistd.h>    /* Definitions of uid_t and gid_t */
@@ -82,12 +82,14 @@ extern "C" {
 #define WIN32_LEAN_AND_MEAN
 
 /* linux unique status defined in sys/stat.h */
+#ifndef LTFS_WINFSP_BUILD
 #define S_IRGRP 0
 #define S_IROTH 0
 #define S_IRWXG 0
 #define S_IRWXO 0
 #define S_IWGRP 0
 #define S_IWOTH 0
+#endif
 
 /* The error numbers not defined in MinGW */
 #ifndef EIDRM
@@ -227,7 +229,11 @@ struct ltfs_timespec {
 	long		tv_nsec;
 };
 
-#ifndef _TM_DEFINED
+#ifdef LTFS_WINFSP_BUILD
+/* Modern CRT owns struct tm. Do not replace a runtime-library ABI type. */
+#include <time.h>
+#endif
+#if !defined(_TM_DEFINED) && !defined(LTFS_WINFSP_BUILD)
 #define _TM_DEFINED
 struct tm
 {
@@ -267,7 +273,11 @@ struct _stat_libltfs
 {
 	_dev_t  st_dev;         /* Equivalent to drive number 0=A 1=B ... */
 	_ino_t  st_ino;         /* Always zero ? */
+#ifdef LTFS_WINFSP_BUILD
+	mode_t st_mode;
+#else
 	_mode_t st_mode;        /* See above constants */
+#endif
 	short   st_nlink;       /* Number of links. */
 	short   st_uid;         /* User: Maybe significant on NT ? */
 	short   st_gid;         /* Group: Ditto */
@@ -307,7 +317,7 @@ struct stat_libltfs
 	blkcnt_t  st_blocks;
 };
 
-#ifndef _STAT_DEFINED
+#if !defined(_STAT_DEFINED) && !defined(LTFS_WINFSP_BUILD)
 #define _STAT_DEFINED
 /* 
  * OSR
diff --git a/src/libltfs/ltfs_thread.h b/src/libltfs/ltfs_thread.h
index c395b4d..305e2ae 100644
--- a/src/libltfs/ltfs_thread.h
+++ b/src/libltfs/ltfs_thread.h
@@ -197,6 +197,12 @@ static inline ltfs_thread_t ltfs_thread_self(void)
 
 #ifdef __APPLE__
 extern uint32_t ltfs_get_thread_id(void);
+#elif defined(LTFS_WINFSP_BUILD)
+/* Only used for diagnostics; independent of the pthread_t representation. */
+static inline uint32_t ltfs_get_thread_id(void)
+{
+	return (uint32_t)GetCurrentThreadId();
+}
 #elif defined(HPE_mingw_BUILD)
 static inline void* ltfs_get_thread_id(void)
 {
