From: LTFS-WinFsp contributors
Subject: [PATCH] Add scoped modern MinGW compilation branch
License: LGPL-2.1-only (upstream-derived patch)
Base: nix-community/hpe-ltfs f909474d71deb0e6a7abc71fd47c16a78b9c1eb0, ltfs/ directory

Compile-enablement only; not a complete WinFsp port. No tape algorithms changed.
The legacy tools depending on tm_zone are not part of this build target.

diff --git a/src/libltfs/arch/win/win_util.c b/src/libltfs/arch/win/win_util.c
index 0a56f3c..569d5e5 100644
--- a/src/libltfs/arch/win/win_util.c
+++ b/src/libltfs/arch/win/win_util.c
@@ -208,6 +208,7 @@ struct tm *get_win32_localtime(const ltfs_time_t *timep)
 	buffer_localtime.tm_wday  = t->tm_wday;
 	buffer_localtime.tm_yday  = t->tm_yday;
 	buffer_localtime.tm_isdst = t->tm_isdst;
+#ifndef LTFS_WINFSP_BUILD
 #if 1
 	buffer_localtime.tm_zone  = "   ";
 #else
@@ -218,6 +219,7 @@ struct tm *get_win32_localtime(const ltfs_time_t *timep)
 	}
 #endif
 
+#endif /* legacy tm_zone extension; not part of the modern CRT ABI */
 	return &buffer_localtime;
 }
 
@@ -239,12 +241,14 @@ struct tm *get_win32_gmtime(const ltfs_time_t *timep)
 	buffer_gmtime.tm_wday  = t->tm_wday;
 	buffer_gmtime.tm_yday  = t->tm_yday;
 	buffer_gmtime.tm_isdst = t->tm_isdst;
+#ifndef LTFS_WINFSP_BUILD
 #if 1
 	buffer_gmtime.tm_zone  = "   ";
 #else
 	buffer_gmtime.tm_zone  = _tzname[0];
 #endif
 
+#endif /* legacy tm_zone extension; not part of the modern CRT ABI */
 	return &buffer_gmtime;
 }
 
diff --git a/src/libltfs/arch/win/win_util.h b/src/libltfs/arch/win/win_util.h
index 6716493..f409ec4 100644
